{ Sensors=
	{ Type= ModeleCapteur }
	{ Data= 
		{ NomFichier= Resultats/Sensors/Capteur } // name of outfile (1 file per point)
		{ NbCapteurs= 5 }
		{ Dimension= 2 }
		{ HAdaptation= 1 } // 1 if points not necessarily same as mesh nodes
		{ Coordonnees=
			{ Point1= 24 -5 } // x y coords
			{ Point2= 24 -2.5 }
			{ Point3= 24 0 }
			{ Point4= 24 2.5 }
			{ Point5= 24 5 }
		}
	}
	{ Dependance= // Add Champ= XXX to print XXX values at the points
		{ Maillage= MaillagePrincipal } // always include
		{ Champ= CompteurTemps }
		{ Champ= Temps }
		{ Champ= Pression }
		{ Champ= Vitesse }
	}
}